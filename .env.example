# SevaDeep — local configuration. Copy to `.env.local`, which is git-ignored.
#
# NO CREDENTIALS BELONG IN THIS FILE. It is committed; .env.local is not.
# The first administrator account is created in the browser at /admin/setup, and only a scrypt
# hash of the password is ever stored.

# ---------------------------------------------------------------------------
# DATABASE (required)
# ---------------------------------------------------------------------------
# Supabase, via the TRANSACTION POOLER (port 6543) — this is what Vercel needs, because each
# serverless invocation is short-lived and the pooler is built for that.
#
# Supabase dashboard -> Settings -> Database -> Connection string -> Transaction pooler
#
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<host>.pooler.supabase.com:6543/postgres?sslmode=require
#
# For tests and offline work, a local Postgres compiled to WebAssembly (no server to install):
# DATABASE_URL=pglite://./data/local-pg

# Max pooled connections per serverless instance. Keep small.
# DATABASE_POOL_MAX=3

# Apply migrations on first database use. For local development and the test harnesses ONLY —
# never set this in production, where several cold starts can begin at once. Production
# migrations are applied out of band with `npm run db:setup`.
# SEVADEEP_AUTO_MIGRATE=1

# ---------------------------------------------------------------------------
# VOLUNTEER MATCHING (optional)
# ---------------------------------------------------------------------------
# Override the weights set in the dashboard's Settings tab. The first three must add up to 1.
# MATCH_WEIGHT_SKILL=0.5
# MATCH_WEIGHT_INTEREST=0.3
# MATCH_WEIGHT_AVAILABILITY=0.2
# MATCH_PREFERENCE_BOOST=10

# Port used by the test harnesses (they start their own server).
# SEVADEEP_TEST_PORT=3177
