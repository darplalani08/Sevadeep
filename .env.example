# SevaDeep platform — local configuration.
#
# Copy to `.env.local` (git-ignored) only if you need to change a default. The application runs
# with no environment file at all.
#
# NO CREDENTIALS BELONG IN THIS FILE. The first administrator account is created once, in the
# browser, at http://localhost:3000/admin/setup, and only a scrypt hash of the password is ever
# stored. Later administrators are added from the dashboard's Settings tab.

# Where the SQLite database lives. Defaults to <project>/data/sevadeep.db.
# SEVADEEP_DB_PATH=./data/sevadeep.db

# Volunteer matching weights. These override whatever is saved from the dashboard's Settings tab.
# The first three must add up to 1.
# MATCH_WEIGHT_SKILL=0.5
# MATCH_WEIGHT_INTEREST=0.3
# MATCH_WEIGHT_AVAILABILITY=0.2
# MATCH_PREFERENCE_BOOST=10

# Port used by the integration and browser test harnesses (they start their own server).
# SEVADEEP_TEST_PORT=3177
